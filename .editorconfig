root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{xml,blp,css}]
indent_size = 2

[meson.build]
indent_size = 2

[meson_options.txt]
indent_size = 2
