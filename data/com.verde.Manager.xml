<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/verde/Manager">
  <interface name="com.verde.Manager">
    <!-- Properties -->
    <property name="DaemonVersion" type="s" access="read"/>
    <property name="OperationInProgress" type="b" access="read"/>

    <!-- Story 1.3: Basic activation test -->
    <method name="Ping"/>

    <!-- Read methods (stubs — implemented in Story 1.6) -->
    <method name="GetGPUInfo">
      <arg name="info" type="a{sv}" direction="out"/>
    </method>
    <method name="GetGPUStats">
      <arg name="stats" type="a{sv}" direction="out"/>
    </method>
    <method name="GetCurrentDriver">
      <arg name="driver" type="a{sv}" direction="out"/>
    </method>
    <method name="ListAvailableDrivers">
      <arg name="drivers" type="aa{sv}" direction="out"/>
      <arg name="metadata" type="a{sv}" direction="out"/>
    </method>
    <method name="GetPowerStatus">
      <arg name="status" type="a{sv}" direction="out"/>
    </method>
    <method name="GenerateDiagnosticReport">
      <arg name="report" type="s" direction="out"/>
    </method>
    <method name="GetPreflightCheck">
      <arg name="operation" type="s" direction="in"/>
      <arg name="result" type="a{sv}" direction="out"/>
    </method>

    <!-- Privileged methods (stubs — implemented in later stories) -->
    <method name="InstallDriver">
      <arg name="version" type="s" direction="in"/>
      <arg name="op_id" type="s" direction="out"/>
    </method>
    <method name="RollbackDriver">
      <arg name="snapshot_id" type="s" direction="in"/>
      <arg name="op_id" type="s" direction="out"/>
    </method>
    <method name="ListSnapshots">
      <arg name="snapshots" type="aa{sv}" direction="out"/>
    </method>
    <method name="DeleteSnapshot">
      <arg name="snapshot_id" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="FixSuspend">
      <arg name="op_id" type="s" direction="out"/>
    </method>
    <method name="FixHibernate">
      <arg name="op_id" type="s" direction="out"/>
    </method>

    <!-- Story 1.10: Degraded state detection -->
    <method name="GetDegradedState">
      <arg name="state_info" type="a{sv}" direction="out"/>
    </method>

    <!-- Story 3.5: Post-reboot summary -->
    <method name="GetPostRebootSummary">
      <arg name="summary" type="a{sv}" direction="out"/>
    </method>
    <method name="ClearPostRebootSummary"/>

    <!-- Signals -->
    <signal name="DegradedStateChanged">
      <arg name="state_info" type="a{sv}"/>
    </signal>
    <signal name="OperationProgress">
      <arg name="op_id" type="s"/>
      <arg name="percent" type="d"/>
      <arg name="message" type="s"/>
    </signal>
    <signal name="OperationComplete">
      <arg name="op_id" type="s"/>
      <arg name="success" type="b"/>
      <arg name="message" type="s"/>
    </signal>
    <signal name="GPUStatsUpdated">
      <arg name="stats" type="a{sv}"/>
    </signal>
    <signal name="RebootRequired">
      <arg name="required" type="b"/>
      <arg name="reason" type="s"/>
    </signal>
  </interface>
</node>
