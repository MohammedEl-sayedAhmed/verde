using Gtk 4.0;
using Adw 1;

template $DiagnosticsPage: Adw.PreferencesPage {
  title: _("Diagnostics");
  icon-name: "utilities-system-monitor-symbolic";

  Adw.PreferencesGroup {
    Adw.StatusPage {
      icon-name: "utilities-system-monitor-symbolic";
      title: _("Diagnostics");
      description: _("System diagnostics will appear here.");
    }
  }
}
