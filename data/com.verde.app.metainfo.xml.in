<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.verde.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Verde</name>
  <summary>NVIDIA GPU Manager for Ubuntu</summary>
  <description>
    <p>
      Verde helps you manage your NVIDIA GPU on Ubuntu. Monitor GPU health,
      install and switch drivers, fix suspend/hibernate issues, and generate
      diagnostic reports — all from a simple, safe interface.
    </p>
    <p>
      On hybrid Optimus laptops Verde detects the PRIME display profile
      (render-offload, integrated, or standard) and applies the matching
      suspend/hibernate configuration automatically.
    </p>
  </description>
  <launchable type="desktop-id">com.verde.app.desktop</launchable>
  <url type="homepage">https://github.com/MohammedEl-sayedAhmed/verde</url>
  <url type="bugtracker">https://github.com/MohammedEl-sayedAhmed/verde/issues</url>
  <url type="vcs-browser">https://github.com/MohammedEl-sayedAhmed/verde</url>
  <screenshots>
