    </screenshot>
    <screenshot>
      <caption>Power — Optimus-aware suspend and hibernate fixes</caption>
      <image type="source" width="990" height="770">https://raw.githubusercontent.com/MohammedEl-sayedAhmed/verde/main/docs/img/verde-power.png</image>
    </screenshot>
    <screenshot>
      <caption>Diagnostics — shareable system report</caption>
      <image type="source" width="990" height="770">https://raw.githubusercontent.com/MohammedEl-sayedAhmed/verde/main/docs/img/verde-diagnostics.png</image>
    </screenshot>
  </screenshots>
